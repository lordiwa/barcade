# Test results (generated artifacts, not source)
Barcade/TestResults/

# NuGet (note: Unity Packages/ folder is tracked — only nuget packages/ is excluded)
/packages/

# Unity Cache Server
Barcade/.cache/

# fast-tests build artifacts (dotnet)
fast-tests/**/bin/
fast-tests/**/obj/

# Root-level transient build/setup logs (e.g. MCP server build)
/*.log

# hivemind advisory session lock (transient, session-local)
state/.lock
